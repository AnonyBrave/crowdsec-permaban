{
  "name": "crowdsec-permaban",
  "version": "1.0.0",
  "description": "Node.js port of PermaBan — CrowdSec Web UI watcher with score-gated auto-bans and a dynamic web UI (zero npm dependencies).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/",
    "build-image": "docker build -t registry.hub.docker.com/youruser/crowdsec-permaban:latest .",
    "push-image": "docker push registry.hub.docker.com/youruser/crowdsec-permaban:latest",
    "run-container": "docker compose up -d"
  },
  "engines": { "node": ">=18" }
}
